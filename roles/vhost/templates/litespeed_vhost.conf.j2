# OpenLiteSpeed Virtual Host Configuration
# Domain: {{ domain }}
# PHP Version: {{ php_versions_all[php_active].label }}
# Generated by Ansible - do not edit directly

vhRoot                    {{ vhost_current_path }}/
docRoot                   $VH_ROOT/{{ vhost_document_root_dirname }}
vhDomain                  {{ domain }}
vhAliases                 www.{{ domain }}
adminEmails               admin@{{ domain }}

# Performance settings
enableGzip                1
enableBrCompression       1
indexFiles                index.php, index.html

# Logging
errorLog                  /usr/local/lsws/logs/{{ domain }}.error_log
accessLog                 /usr/local/lsws/logs/{{ domain }}.access_log

# SSL/TLS is intentionally not enabled here before certificate issuance.
# Certbot runs later in the play, and referencing missing certificate files
# would make the first deployment more fragile.

# Note: External apps and context mappings are configured in /usr/local/lsws/conf/httpd_config.conf
# To switch PHP versions, see /usr/local/etc/php-versions/<version>-ols-external-apps.conf
# and reference the appropriate external processor in your context mappings
