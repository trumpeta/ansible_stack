<VirtualHost *:80>
    ServerName {{ domain }}
    ServerAlias www.{{ domain }}

    DocumentRoot /var/www/{{ domain }}/current

    <Directory /var/www/{{ domain }}/current>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/{{ domain }}_error.log
    CustomLog ${APACHE_LOG_DIR}/{{ domain }}_access.log combined
</VirtualHost>