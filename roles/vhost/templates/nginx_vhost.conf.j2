server {
    listen 80;
    server_name {{ domain }} www.{{ domain }};

    root /var/www/{{ domain }}/current;
    index index.php index.html index.htm;

    # For multiple PHP versions: include /usr/local/etc/php-versions/php-nginx-upstreams.conf;
    # Then change fastcgi_pass to: fastcgi_pass phpfpm_<version>;

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        # Active PHP version: {{ php_versions_all[php_active].label }}
        fastcgi_pass unix:/var/run/php/php{{ php_active }}-fpm.sock;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
    }

    location ~ /\.ht {
        deny all;
    }
}